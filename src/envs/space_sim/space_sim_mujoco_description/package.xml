<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>space_sim_mujoco_description</name>
  <version>1.0.0</version>
  <description>This package contains a mujoco environment for dual UR robots (space simulation).</description>
  <maintainer email="user@email.com">Your Name</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>velocity_controllers</depend>
  <depend>force_torque_sensor_broadcaster</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>space_sim_description</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>