<?xml version="1.0"?>
<robot name="space_sim" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find space_sim_description)/xacro/dual_arm_config.xacro"/>
  <xacro:include filename="$(find space_sim_description)/xacro/space_sim_arm_macro.xacro"/>

  <!-- Jazzy: 纯几何描述，不包含 ros2_control -->
  <xacro:macro name="space_sim" params="
  camera_use_nominal_extrinsics:=false
  safety_limits:=false
  safety_pos_margin:=0.15
  safety_k_position:=20
  force_abs_paths:=false
  ">

  <!-- 定义材料 -->
  <material name="satellite_material">
    <texture filename="package://space_sim_description/meshes/gold_leaf.png" />
  </material>
  <material name="len_shelf_material">
    <color rgba="0.60 0.60 0.60 1"/>
  </material>

  <link name="world"/>
  <link name="base_link"/>
  <joint name="world_to_base_link" type="fixed">
    <parent link="world" />
    <child link="base_link" />
  </joint>

  <!-- base_link 到 satellite 的固定连接 -->
  <joint name="base_link_to_satellite" type="fixed">
    <parent link="base_link" />
    <child link="satellite" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ============================================ -->
  <!-- 固定方块 satellite (0.6*0.6*0.6 m, 300 kg)   -->
  <!-- 固定在 world 原点，中心在 (0,0,0)            -->
  <!-- 惯量: 均匀立方体 I = m/12*(a²+b²)           -->
  <!--       = 300/12*(0.6²+0.6²) = 18 kg·m²       -->
  <!-- ============================================ -->
  <link name="satellite">
    <inertial>
      <mass value="300.0"/>
      <inertia ixx="18.0" ixy="0.0" ixz="0.0" iyy="18.0" iyz="0.0" izz="18.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.6 0.6 0.6"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <material name="satellite_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.6 0.6"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
    </collision>
  </link>

  <!-- ============================================ -->
  <!-- 镜片部分                                      -->
  <!-- ============================================ -->

  <!-- 镜片支架 -->
  <link name="len_shelf">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.032292" ixy="0.0" ixz="0.0" iyy="0.032292" iyz="0.0" izz="0.0625"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.02" length="1.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.75" />
      <material name="len_shelf_material"/>
    </visual>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 1.5" />
      <material name="len_shelf_material"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="1.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.75" />
    </collision>
  </link>
  <joint name="satellite_to_len_shelf" type="fixed">
    <parent link="satellite" />
    <child link="len_shelf" />
    <origin xyz="0 0 0.30" rpy="0 0 0" />
  </joint>

  <!-- 中心镜片 -->
  <link name="len_center">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.032292" ixy="0.0" ixz="0.0" iyy="0.032292" iyz="0.0" izz="0.0625"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/len_center.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/len_center.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="len_shelf_to_center" type="fixed">
    <parent link="len_shelf" />
    <child link="len_center" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
  </joint>

  <!-- <link name="len_ring1_1">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.032292" ixy="0.0" ixz="0.0" iyy="0.032292" iyz="0.0" izz="0.0625"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/len_ring1.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/len_ring1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="len_center_to_ring1_1" type="fixed">
    <parent link="len_center" />
    <child link="len_ring1_1" />
    <origin xyz="-0.5130 -0.0000 0.0905" rpy="-0.349066 -0.000000 -1.570796"/>
  </joint> -->

  <!-- ============================================ -->
  <!-- 卫星附件 太阳能板                            -->
  <!-- 对侧安装: 在 +/-Y 侧面                       -->
  <!-- 方块半宽 0.3，安装面在 y=±0.3                -->
  <!-- ============================================ -->

  <link name="solar_panel_A">
    <inertial>
      <mass value="6.580"/>
      <origin xyz="-1.309 0.003 0.000" rpy="0 0 0" />
      <inertia ixx="0.1246" ixy="0.0" ixz="0.0" iyy="2.090" iyz="0.0" izz="1.965"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/solar_panel.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/solar_panel.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="satellite_to_solar_panel_A" type="fixed">
    <parent link="satellite" />
    <child link="solar_panel_A" />
    <origin xyz="0 0.3 0" rpy="0 0 ${-pi/2}" />
  </joint>

  <link name="solar_panel_B">
    <inertial>
      <mass value="6.580"/>
      <origin xyz="-1.309 0.003 0.000" rpy="0 0 0" />
      <inertia ixx="0.1246" ixy="0.0" ixz="0.0" iyy="2.090" iyz="0.0" izz="1.965"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/solar_panel.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://space_sim_description/meshes/solar_panel.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="satellite_to_solar_panel_B" type="fixed">
    <parent link="satellite" />
    <child link="solar_panel_B" />
    <origin xyz="0 -0.3 0" rpy="0 0 ${pi/2}" />
  </joint>

  <!-- ============================================ -->
  <!-- UR 安装座 link & joint                        -->
  <!-- 对侧安装: arm_A 在 +X 侧面, arm_B 在 -X 侧面  -->
  <!-- 方块半宽 0.3，安装面在 x=±0.3                 -->
  <!-- ============================================ -->
  <link name="ur_mount_A"/>
  <joint name="satellite_to_ur_mount_A" type="fixed">
    <parent link="satellite"/>
    <child link="ur_mount_A"/>
    <origin xyz="0.3 0 0" rpy="0 ${pi/2} 0" />
  </joint>

  <link name="ur_mount_B"/>
  <joint name="satellite_to_ur_mount_B" type="fixed">
    <parent link="satellite"/>
    <child link="ur_mount_B"/>
    <origin xyz="-0.3 0 0" rpy="0 ${-pi/2} 0" />
  </joint>

  <!-- 创建 UR 机器人 (Jazzy: 仅传几何相关参数) -->
  <xacro:space_sim_arm
    name = "ur_A"
    tf_prefix = "${arm_A_tf_prefix}"
    parent = "ur_mount_A"
    ur_type = "${ur_A_ur_type}"
    kinematics_parameters_file = "${ur_A_kinematics_parameters_file}"
    gripper_type = "${gripper_type}"
    realsense_use_nominal_extrinsics = "${camera_use_nominal_extrinsics}"
    safety_limits = "${safety_limits}"
    safety_pos_margin = "${safety_pos_margin}"
    safety_k_position = "${safety_k_position}"
    force_abs_paths = "${force_abs_paths}"
  >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:space_sim_arm>

  <xacro:space_sim_arm
    name = "ur_B"
    tf_prefix = "${arm_B_tf_prefix}"
    parent = "ur_mount_B"
    ur_type = "${ur_B_ur_type}"
    kinematics_parameters_file = "${ur_B_kinematics_parameters_file}"
    gripper_type = "${gripper_type}"
    realsense_use_nominal_extrinsics = "${camera_use_nominal_extrinsics}"
    safety_limits = "${safety_limits}"
    safety_pos_margin = "${safety_pos_margin}"
    safety_k_position = "${safety_k_position}"
    force_abs_paths = "${force_abs_paths}"
  >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:space_sim_arm>

  </xacro:macro>
</robot>