<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================ -->
  <!-- 通用依赖（UR 机械臂本体 + RealSense 相机）   -->
  <!-- ============================================ -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />

  <!-- ============================================ -->
  <!-- 夹爪类型条件依赖（预留，后续添加时启用）     -->
  <!-- ============================================ -->
  <!--
  <xacro:if value="${gripper_type == 'robotiq_2f85'}">
    <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />
    <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro" />
  </xacro:if>
  <xacro:if value="${gripper_type == 'dh_ag95'}">
    <xacro:include filename="$(find dh_ag95_description)/urdf/dh_ag95_macro.urdf.xacro" />
  </xacro:if>
  -->


  <!-- 宏定义自己的机械臂结构 UR + RealSense（无夹爪） -->
  <!-- Jazzy: 仅纯几何描述，不包含任何 ros2_control -->
  <xacro:macro name="space_sim_arm" params="
    name:=space_sim_arm
    tf_prefix:=space_sim_arm
    parent:=world
    ur_type:=ur5e
    kinematics_parameters_file:=''
    gripper_type:=none
    realsense_use_nominal_extrinsics:=false
    safety_limits:=false
    safety_pos_margin:=0.15
    safety_k_position:=20
    force_abs_paths:=false
    *origin
    ">

    <!-- 机械臂基座 parameters -->
    <xacro:property name="_arm_base_name" value="${tf_prefix}base"/>


    <!-- UR parameters (Jazzy: 仅 yaml 配置文件路径) -->
    <xacro:property name="_ur_name" value="${name}_ur"/>
    <xacro:property name="_ur_tf_prefix" value="${tf_prefix}ur_"/>
    <xacro:property name="_ur_parent" value="${_arm_base_name}_main"/>
    <xacro:property name="_ur_joint_limits_parameters_file" value="$(find ur_description)/config/${ur_type}/joint_limits.yaml"/>
    <xacro:if value="${kinematics_parameters_file == ''}">
      <xacro:property name="_ur_kinematics_parameters_file" value="$(find ur_description)/config/${ur_type}/default_kinematics.yaml"/>
    </xacro:if>
    <xacro:unless value="${kinematics_parameters_file == ''}">
      <xacro:property name="_ur_kinematics_parameters_file" value="${kinematics_parameters_file}"/>
    </xacro:unless>
    <xacro:property name="_ur_physical_parameters_file" value="$(find ur_description)/config/${ur_type}/physical_parameters.yaml"/>
    <xacro:property name="_ur_visual_parameters_file" value="$(find ur_description)/config/${ur_type}/visual_parameters.yaml"/>

    <!-- RealSense parameters -->
    <xacro:property name="_realsense_name" value="${tf_prefix}realsense" />
    <xacro:property name="_realsense_prefix" value="${tf_prefix}realsense" />
    <xacro:property name="_realsense_use_nominal_extrinsics" value="${realsense_use_nominal_extrinsics}" />
    <xacro:property name="_realsense_add_plug" value="false" />
    <xacro:property name="_realsense_use_mesh" value="true" />

    <!-- gripper parameters -->
    <xacro:property name="_gripper_name" value="${tf_prefix}gripper" />



    <!-- 机械臂基座-->
    <link name="${_arm_base_name}_dock">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.6"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.07" length="0.025"/>
        </geometry>
        <material name="arm_base_dock_material">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.07" length="0.025"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
    </link>
    <joint name="${_arm_base_name}_dock_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${_arm_base_name}_dock"/>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
    </joint>


    <link name="${_arm_base_name}_main">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="35.0"/>
        <inertia ixx="0.182" ixy="0.0" ixz="0.0" iyy="0.182" iyz="0.0" izz="0.233"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.3 0.3 0.2"/>
        </geometry>
        <material name="arm_base_main_material">
          <texture filename="package://space_sim_description/meshes/gold_leaf.png"/>
        </material>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.3 0.3 0.2"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
    </link>
    <joint name="${_arm_base_name}_dock_to_main_joint" type="fixed">
      <parent link="${_arm_base_name}_dock"/>
      <child link="${_arm_base_name}_main"/>
      <origin xyz="0 0 0.1125" rpy="0 0 0"/>
    </joint>


    <!-- 创建 UR 机器人 使用宏定义 (Jazzy: 纯描述，无 ros2_control 参数) -->
    <xacro:ur_robot
      name="${_ur_name}"
      tf_prefix="${_ur_tf_prefix}"
      parent="${_ur_parent}"
      joint_limits_parameters_file="${_ur_joint_limits_parameters_file}"
      kinematics_parameters_file="${_ur_kinematics_parameters_file}"
      physical_parameters_file="${_ur_physical_parameters_file}"
      visual_parameters_file="${_ur_visual_parameters_file}"
      safety_limits="${safety_limits}"
      safety_pos_margin="${safety_pos_margin}"
      safety_k_position="${safety_k_position}"
      force_abs_paths="${force_abs_paths}"
    >
      <!-- <xacro:insert_block name="origin" /> -->
      <origin xyz="0 0 0.1" rpy="0 0 0" />
    </xacro:ur_robot>

    <!-- ============================================ -->
    <!-- RealSense 相机支架                           -->
    <!-- 该支架的相机螺纹孔距离机械臂末端圆心100mm，  -->
    <!-- 支架厚度3mm（与 lab_bench 使用同一支架）     -->
    <!-- ============================================ -->
    <link name="${_realsense_prefix}_shelf">
      <inertial>
        <origin xyz="0.0 0.044 0.0015" rpy="0.0 0.0 0.0"/>
        <mass value="0.038"/>
        <inertia ixx="0.00006673" ixy="0.0" ixz="0.0" iyy="0.00000850" iyz="0.0" izz="0.00007517"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://space_sim_description/meshes/RealSense_D435_Shelf.STL"/>
        </geometry>
        <material name="anodized_aluminum">
          <color rgba="0.7 0.7 0.7 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://space_sim_description/meshes/RealSense_D435_Shelf.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${_realsense_prefix}_tool0_to_realsense_shelf" type="fixed">
      <parent link="${_ur_tf_prefix}tool0"/>
      <child link="${_realsense_prefix}_shelf"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${pi}" />
    </joint>
    <!-- 创建 RealSense 相机支架 child 端的 link 和 joint -->
    <link name="${_realsense_prefix}_shelf_child_side"/>
    <joint name="${_realsense_prefix}_shelf_to_child_side" type="fixed">
      <parent link="${_realsense_prefix}_shelf"/>
      <child link="${_realsense_prefix}_shelf_child_side"/>
      <!-- 相机支架厚度 3mm + 夹爪底座坐标z轴偏移3mm -->
      <origin xyz="0.0 0.0 0.006" rpy="0 0 0" />
    </joint>
    <!-- ============================================ -->
    <!-- RealSense D435 相机（无夹爪，直接挂在支架上） -->
    <!-- ============================================ -->
    <!-- params 'name' is actually tf_prefix with '_' -->
    <xacro:sensor_d435
      parent="${_realsense_prefix}_shelf"
      name="${_realsense_prefix}"
      use_nominal_extrinsics="${_realsense_use_nominal_extrinsics}"
      add_plug="${_realsense_add_plug}"
      use_mesh="${_realsense_use_mesh}"
    >
      <!-- RealSense 的基座位于相机底部的1/4螺纹孔，距离后背面10mm，底部平面距离后背2个螺纹孔所在直线12.5mm -->
      <origin xyz="0 0.0875 0.013" rpy="0 ${-pi/2} ${-pi/2}"/>
    </xacro:sensor_d435>

    <!-- ============================================ -->
    <!-- 夹爪                                         -->
    <!-- ============================================ -->
    <link name="${_gripper_name}_base">
      <inertial>
        <origin xyz="0.0 0.0 0.055348" rpy="0.0 0.0 0.0"/>
        <mass value="1.203"/>
        <inertia ixx=" 0.001246" ixy="0.0" ixz="0.0" iyy="0.001777" iyz="0.0" izz="0.001085"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://space_sim_description/meshes/magnetic_gripper.STL"/>
        </geometry>
        <material name="gripper_base_material">
          <color rgba="0.6 0.6 0.6 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://space_sim_description/meshes/magnetic_gripper.STL"/>
        </geometry>
      </collision>
    </link>
    <joint name="${_realsense_prefix}_shelf_to_${_gripper_name}_base" type="fixed">
      <parent link="${_realsense_prefix}_shelf_child_side"/>
      <child link="${_gripper_name}_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${_gripper_name}_dock">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.1 0.04 0.02"/>
        </geometry>
        <material name="gripper_dock_material">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 0.04 0.02"/>
        </geometry>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
      </collision>
    </link>
    <joint name="${_gripper_name}_base_to_${_gripper_name}_dock" type="fixed">
      <parent link="${_gripper_name}_base"/>
      <child link="${_gripper_name}_dock"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>


    <link name="${tf_prefix}_tcp"/>
      <joint name="${tf_prefix}_tcp_joint" type="fixed">
          <origin xyz="0 0 0.12" rpy="0 0 0"/>
          <parent link="${_gripper_name}_base"/>
          <child link="${tf_prefix}_tcp"/>
      </joint>

  </xacro:macro>
</robot>