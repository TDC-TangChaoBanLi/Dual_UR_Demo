; ============================================================
; Dual UR OCS2 Task Configuration
; Arm A: UR5e (右臂/right), Arm B: UR5e (左臂/left)
; OCS2 leftArm=arm_B(eeFrame), rightArm=arm_A(eeFrame1)
; —— 与物理左右一致：Left Arm Target 显示在 arm_B（物理左臂），
;    Right Arm Target 显示在 arm_A（物理右臂）。
; space_sim 无夹爪，末端帧直接使用 UR 机械臂 tool0。
; ============================================================

model_information {
  manipulatorModelType     0      ; 0: Default-arm (fixed base)

  ; base frame 
  baseFrame                 "base_link"

  ; end-effector frames — eeFrame 对应 OCS2 leftArm, eeFrame1 对应 rightArm
  ; space_sim 无夹爪，直接使用 UR tool0 作为末端执行器帧
  eeFrame                   "arm_B__tcp"
  eeFrame1                  "arm_A__tcp"

  ; 无夹爪关节，无需 removeJoints
}

model_settings {
  usePreComputation         true
  recompileLibraries        true
}

; ============================================================
; DDP 优化参数
; ============================================================
ddp {
  algorithm                  SLQ
  nThreads                   3
  threadPriority             50

  maxNumIterations           1      ; 双臂 12 关节计算量大，降低迭代次数保证实时性
  minRelCost                 0.1
  constraintTolerance        1e-3

  displayInfo                false
  displayShortSummary        false
  checkNumericalStability    false

  debugPrintRollout          false
  debugCaching               false

  AbsTolODE                  1e-5
  RelTolODE                  1e-3
  maxNumStepsPerSecond       100000
  timeStep                   1e-3
  backwardPassIntegratorType ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms     true
  useFeedbackPolicy          false

  strategy                   LINE_SEARCH
  lineSearch {
    minStepLength            1e-2
    maxStepLength            1.0
    hessianCorrectionStrategy DIAGONAL_SHIFT
    ; 对齐 ROKAE 参考（1e-3）：末端跟踪权重提高后代价 Hessian 放大，
    ; 过小的修正（1e-5）会导致 Riccati 回代数值爆炸（SLQ 段错误）。
    hessianCorrectionMultiple 1e-3
  }
}

; ============================================================
; Rollout 设置
; ============================================================
rollout {
  AbsTolODE                  1e-5
  RelTolODE                  1e-3
  timeStep                   1e-2
  integratorType             ODE45
  maxNumStepsPerSecond       100000
  checkNumericalStability    false
}

; ============================================================
; MPC 设置
; ============================================================
mpc {
  timeHorizon                1.0     ; [s] 预测时域
  solutionTimeWindow         0.2     ; [s]
  coldStart                  false
  debugPrint                 false
  mpcDesiredFrequency        100      ; [Hz] MPC 求解频率
  mrtDesiredFrequency        500     ; [Hz] MRT 策略评估频率
}

; ============================================================
; 初始状态（2 × 6 = 12 关节）
; 关节顺序匹配 URDF/Pinocchio: arm_A (0-5) → arm_B (6-11)
; ============================================================
initialState {
  base { defaultManipulator {} }

  arm {
    ; Arm A (UR5e) — 右臂 — 6 joints
    (0,0)  -1.5708  ; arm_A shoulder_pan
    (1,0)   3.6416  ; arm_A shoulder_lift
    (2,0)  -1.4     ; arm_A elbow
    (3,0)  -0.6708  ; arm_A wrist_1
    (4,0)   1.5708  ; arm_A wrist_2
    (5,0)  -1.5708  ; arm_A wrist_3

    ; Arm B (UR5e) — 左臂 — 6 joints
    (6,0)   1.5708  ; arm_B shoulder_pan
    (7,0)  -0.6     ; arm_B shoulder_lift
    (8,0)   1.4     ; arm_B elbow
    (9,0)  -2.3708  ; arm_B wrist_1
    (10,0) -1.5708  ; arm_B wrist_2
    (11,0)  1.5708  ; arm_B wrist_3
  }
}

; ============================================================
; 输入代价（关节速度惩罚）
; ============================================================
inputCost {
  R {
    base { defaultManipulator {} }
    arm {
      scaling 1e-3
      ; Arm A (右臂, 索引 0-5)
      (0,0)  1.0   
      (1,1)  1.0   
      (2,2)  1.0
      (3,3)  1.0   
      (4,4)  1.0   
      (5,5)  1.0
      ; Arm B (左臂, 索引 6-11)
      (6,6)  1.0   
      (7,7)  1.0   
      (8,8)  1.0
      (9,9)  1.0  
      (10,10) 1.0  
      (11,11) 1.0
    }
  }
}

; ============================================================
; 末端执行器跟踪代价
; 在 ROKAE 参考（endEffector 100/50, final 200/100）与数值稳定性间折中：
;   12 关节双臂 + 高权重下 SLQ Riccati 回代会数值爆炸（段错误），
;   故采用 4 倍提升（20/10, 40/20）兼顾跟踪响应与稳定。
; ============================================================
endEffector {
  dualArmMode      true

  leftArm {
    muPosition      20.0
    muOrientation   10.0
  }

  rightArm {
    muPosition      20.0
    muOrientation   10.0
  }
}

finalEndEffector {
  dualArmMode      true

  leftArm {
    muPosition      40.0
    muOrientation   20.0
  }

  rightArm {
    muPosition      40.0
    muOrientation   20.0
  }
}

; ============================================================
; 自碰撞（初次部署先关闭）
; ============================================================
selfCollision {
  activate  false
  minimumDistance  0.015
  mu      1e-2
  delta   1e-3
  collisionObjectPairs
  {
  }
  collisionLinkPairs
  {
  }
}

; ============================================================
; 关节位置 / 速度限制
; ============================================================
jointPositionLimits {
  activate  true
  mu       0.001
  delta    1e-3
}

jointVelocityLimits {
  mu       0.01
  delta    1e-3

  lowerBound {
    base
    {
      defaultManipulator
      {
      }
    }
    arm {
      ; Arm A (右臂): 6 joints @ ±3.14 rad/s
      (0,0)  -3.14  
      (1,0)  -3.14  
      (2,0)  -3.14
      (3,0)  -3.14  
      (4,0)  -3.14  
      (5,0)  -3.14
      ; Arm B (左臂): 6 joints @ ±3.14 rad/s
      (6,0)  -3.14  
      (7,0)  -3.14  
      (8,0)  -3.14
      (9,0)  -3.14  
      (10,0) -3.14  
      (11,0) -3.14
    }
  }

  upperBound {
    base
    {
      defaultManipulator
      {
      }
    }
    arm {
      (0,0)   3.14  
      (1,0)   3.14  
      (2,0)   3.14
      (3,0)   3.14  
      (4,0)   3.14  
      (5,0)   3.14
      (6,0)   3.14  
      (7,0)   3.14  
      (8,0)   3.14
      (9,0)   3.14  
      (10,0)  3.14  
      (11,0)  3.14
    }
  }
}