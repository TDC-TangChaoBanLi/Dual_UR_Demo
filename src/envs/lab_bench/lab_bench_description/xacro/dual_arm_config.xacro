<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    双臂共享配置文件
    ================
    本文件统一存放 lab_bench_macro.xacro 和 lab_bench.xacro 中
    需要保持一致的双臂属性，避免在两处重复定义。

    修改规则：只需修改本文件中的值，所有引用方自动同步。
  -->

  <!-- ============================================ -->
  <!-- 臂 A 配置                                   -->
  <!-- ============================================ -->
  <xacro:property name="arm_A_tf_prefix" value="arm_A_"/>
  <xacro:property name="ur_A_ur_type" value="ur5"/>
  <xacro:property name="ur_A_kinematics_parameters_file" value="$(find lab_bench_description)/config/ros2_control/ur_A_kinematics_calibration.yaml"/>

  <!-- ============================================ -->
  <!-- 臂 B 配置                                   -->
  <!-- ============================================ -->
  <xacro:property name="arm_B_tf_prefix" value="arm_B_"/>
  <xacro:property name="ur_B_ur_type" value="ur5e"/>
  <xacro:property name="ur_B_kinematics_parameters_file" value="$(find lab_bench_description)/config/ros2_control/ur_B_kinematics_calibration.yaml"/>

  <!-- ============================================ -->
  <!-- 夹爪类型选择                                -->
  <!-- ============================================ -->
  <!-- 可选值: "dh_ag95" | "robotiq_2f85"           -->
  <!-- 注意: 双臂使用同款夹爪，暂不支持混合配置      -->
  <!--       如需双臂不同夹爪，请拆分为 gripper_type_A / gripper_type_B -->
  <xacro:property name="gripper_type" value="dh_ag95"/>

</robot>
