; ============================================================
; Dual UR OCS2 Task Configuration
; Arm A: UR5 (右臂/right), Arm B: UR5e (左臂/left)
; 注意: OCS2 leftArm=arm_A(eeFrame), rightArm=arm_B(eeFrame1)
; ============================================================

model_information {
  manipulatorModelType     0      ; 0: Default-arm (fixed base)

  ; base frame — arm_shelf（有惯性属性的 link，满足 Pinocchio 动力学计算要求）
  baseFrame                 "arm_shelf"

  ; end-effector frames — eeFrame 对应 OCS2 leftArm, eeFrame1 对应 rightArm
  eeFrame                   "arm_A__tcp"
  eeFrame1                  "arm_B__tcp"

  ; 锁定 gripper 关节（仅保留 12 个 arm 关节参与 MPC 优化）
  removeJoints {
    [0] "arm_A_dhag95_gripper_finger1_joint"
    [1] "arm_B_dhag95_gripper_finger1_joint"
  }
}

model_settings {
  usePreComputation         true
  recompileLibraries        true
}

; ============================================================
; DDP 优化参数
; ============================================================
ddp {
  algorithm                  SLQ
  nThreads                   3
  threadPriority             50

  maxNumIterations           1      ; 双臂 12 关节计算量大，降低迭代次数保证实时性
  minRelCost                 0.1
  constraintTolerance        1e-3

  displayInfo                false
  displayShortSummary        false
  checkNumericalStability    false

  AbsTolODE                  1e-5
  RelTolODE                  1e-3
  maxNumStepsPerSecond       100000
  timeStep                   1e-3
  backwardPassIntegratorType ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms     true
  useFeedbackPolicy          false

  strategy                   LINE_SEARCH
  lineSearch {
    minStepLength            1e-2
    maxStepLength            1.0
    hessianCorrectionStrategy DIAGONAL_SHIFT
    hessianCorrectionMultiple 1e-5
  }
}

; ============================================================
; Rollout 设置
; ============================================================
rollout {
  AbsTolODE                  1e-5
  RelTolODE                  1e-3
  timeStep                   1e-2
  integratorType             ODE45
  maxNumStepsPerSecond       100000
  checkNumericalStability    false
}

; ============================================================
; MPC 设置
; ============================================================
mpc {
  timeHorizon                2.0     ; [s] 预测时域
  solutionTimeWindow         0.4     ; [s]
  coldStart                  false

  mpcDesiredFrequency        50      ; [Hz] MPC 求解频率
  mrtDesiredFrequency        200     ; [Hz] MRT 策略评估频率
}

; ============================================================
; 初始状态（2 × 6 = 12 关节）
; 关节顺序匹配 URDF/Pinocchio: arm_A (0-5) → arm_B (6-11)
; ============================================================
initialState {
  base { defaultManipulator {} }

  arm {
    ; Arm A (UR5) — 右臂 — 6 joints
    (0,0)  -1.5708  ; arm_A shoulder_pan
    (1,0)   3.6416  ; arm_A shoulder_lift
    (2,0)  -1.4     ; arm_A elbow
    (3,0)  -0.6708  ; arm_A wrist_1
    (4,0)   1.5708  ; arm_A wrist_2
    (5,0)  -1.5708  ; arm_A wrist_3

    ; Arm B (UR5e) — 左臂 — 6 joints
    (6,0)   1.5708  ; arm_B shoulder_pan
    (7,0)  -0.6     ; arm_B shoulder_lift
    (8,0)   1.4     ; arm_B elbow
    (9,0)  -2.3708  ; arm_B wrist_1
    (10,0) -1.5708  ; arm_B wrist_2
    (11,0)  1.5708  ; arm_B wrist_3
  }
}

; ============================================================
; 输入代价（关节速度惩罚）
; ============================================================
inputCost {
  R {
    base { defaultManipulator {} }
    arm {
      scaling 1e-3
      ; Arm A (右臂, 索引 0-5)
      (0,0)  1.0   (1,1)  1.0   (2,2)  1.0
      (3,3)  1.0   (4,4)  1.0   (5,5)  1.0
      ; Arm B (左臂, 索引 6-11)
      (6,6)  1.0   (7,7)  1.0   (8,8)  1.0
      (9,9)  1.0  (10,10) 1.0  (11,11) 1.0
    }
  }
}

; ============================================================
; 末端执行器跟踪代价
; ============================================================
endEffector {
  dualArmMode      true

  leftArm {
    muPosition      5.0
    muOrientation   2.5
  }

  rightArm {
    muPosition      5.0
    muOrientation   2.5
  }
}

finalEndEffector {
  dualArmMode      true

  leftArm {
    muPosition      5.0
    muOrientation   2.5
  }

  rightArm {
    muPosition      5.0
    muOrientation   2.5
  }
}

; ============================================================
; 自碰撞（初次部署先关闭）
; ============================================================
selfCollision {
  activate  false
  minimumDistance  0.015
  mu      1e-2
  delta   1e-3
}

; ============================================================
; 关节位置 / 速度限制
; ============================================================
jointPositionLimits {
  activate  true
  mu       0.001
  delta    1e-3
}

jointVelocityLimits {
  mu       0.01
  delta    1e-3

  lowerBound {
    arm {
      ; Arm A (右臂): 6 joints @ ±3.14 rad/s
      (0,0)  -3.14  (1,0)  -3.14  (2,0)  -3.14
      (3,0)  -3.14  (4,0)  -3.14  (5,0)  -3.14
      ; Arm B (左臂): 6 joints @ ±3.14 rad/s
      (6,0)  -3.14  (7,0)  -3.14  (8,0)  -3.14
      (9,0)  -3.14  (10,0) -3.14  (11,0) -3.14
    }
  }

  upperBound {
    arm {
      (0,0)   3.14  (1,0)   3.14  (2,0)   3.14
      (3,0)   3.14  (4,0)   3.14  (5,0)   3.14
      (6,0)   3.14  (7,0)   3.14  (8,0)   3.14
      (9,0)   3.14  (10,0)  3.14  (11,0)  3.14
    }
  }
}
