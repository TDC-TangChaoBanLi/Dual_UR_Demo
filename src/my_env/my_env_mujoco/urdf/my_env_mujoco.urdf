      <mass value="0.0124305"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="2.84217e-06" ixy="-2.48048e-15" ixz="8.24539e-07" iyy="3.03961e-06" iyz="2.16427e-13" izz="1.11815e-06"/>
    </inertial>
  </link>
  <!-- 创建 TCP (AG-95 末端) -->
  <!-- TODO: 请根据实际 AG-95 尺寸调整 origin xyz 偏移 -->
  <link name="arm_B__tcp"/>
  <joint name="arm_B__tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.14"/>
    <parent link="arm_B_dhag95_gripper_base_link"/>
    <child link="arm_B__tcp"/>
  </joint>
  <!-- ! Match the prefix in my_arm_macro.urdf.xacro -->
  <ros2_control name="my_env_ros2_mujoco" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">/home/tdc/CodeProjects/Dual_UR_Demo/install/my_env_mujoco/share/my_env_mujoco/mjcf/my_env_mujoco.xml</param>
      <!-- Optional: load PID gains from a ROS parameters YAML file.
        Enables position/velocity PID control for velocity, motor, and custom actuators. -->
      <param name="pids_config_file">/home/tdc/CodeProjects/Dual_UR_Demo/install/my_env_control/share/my_env_control/config/mujoco_pids_config.yaml</param>
      <!-- Override the slowdown settings in the Simulate App -->
      <param name="sim_speed_factor">1.0</param>
      <!-- If set to true, will not launch the Simulate App window -->
      <param name="headless">false</param>
    </hardware>
    <!-- UR 机械臂相关 -->
    <joint name="arm_A_ur_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">3.6416</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.4</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-0.6708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <sensor name="arm_A_ur_tcp_fts_sensor">
      <param name="mujoco_type">fts</param>
      <!-- There is _no requirement_ for the mujoco_sensor_name to match the ros2_control sensor name -->
      <param name="mujoco_sensor_name">arm_A_ur_tcp_fts_sensor</param>
      <!-- Default value of force_mjcf_suffix is '_force' -->
      <param name="force_mjcf_suffix">_force</param>
      <!-- Default value of torque_mjcf_suffix is '_torque' -->
      <param name="torque_mjcf_suffix">_torque</param>
      <!-- 上述三个参数配合形成 mjcf 中的力和力矩传感器名称：{mujoco_sensor_name}{force_mjcf_suffix} 和 {mujoco_sensor_name}{torque_mjcf_suffix}  -->
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <!-- ============================================ -->
    <!-- 夹爪（根据 gripper_type 条件选择）            -->
    <!-- gripper_type 由 dual_arm_config.xacro 定义   -->
    <!-- ============================================ -->
    <joint name="arm_A_gripper_finger1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- UR 机械臂相关 -->
    <joint name="arm_B_ur_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-0.6</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.4</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-2.3708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <sensor name="arm_B_ur_tcp_fts_sensor">
      <param name="mujoco_type">fts</param>
      <!-- There is _no requirement_ for the mujoco_sensor_name to match the ros2_control sensor name -->
      <param name="mujoco_sensor_name">arm_B_ur_tcp_fts_sensor</param>
      <!-- Default value of force_mjcf_suffix is '_force' -->
      <param name="force_mjcf_suffix">_force</param>
      <!-- Default value of torque_mjcf_suffix is '_torque' -->
      <param name="torque_mjcf_suffix">_torque</param>
      <!-- 上述三个参数配合形成 mjcf 中的力和力矩传感器名称：{mujoco_sensor_name}{force_mjcf_suffix} 和 {mujoco_sensor_name}{torque_mjcf_suffix}  -->
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <!-- ============================================ -->
    <!-- 夹爪（根据 gripper_type 条件选择）            -->
    <!-- gripper_type 由 dual_arm_config.xacro 定义   -->
    <!-- ============================================ -->
    <joint name="arm_B_gripper_finger1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
