  <!-- base_joint fixes base_link to the environment -->
  <joint name="arm_B_ur_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="ur_mount_B"/>
    <child link="arm_B_ur_base_link"/>
