    <parent link="arm_B_realsense_shelf"/>
    <child link="arm_B_realsense_shelf_child_side"/>
    <!-- 相机支架厚度 3mm + 夹爪底座坐标z轴偏移3mm -->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.006"/>
  </joint>
