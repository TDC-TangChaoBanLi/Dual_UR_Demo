  <joint name="arm_A_ur_wrist_3_link-ft_frame" type="fixed">
    <parent link="arm_A_ur_wrist_3_link"/>
    <child link="arm_A_ur_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="arm_A_ur_base"/>
  <joint name="arm_A_ur_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="arm_A_ur_base_link"/>
    <child link="arm_A_ur_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="arm_A_ur_flange"/>
  <joint name="arm_A_ur_wrist_3-flange" type="fixed">
    <parent link="arm_A_ur_wrist_3_link"/>
    <child link="arm_A_ur_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="arm_A_ur_tool0"/>
  <joint name="arm_A_ur_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_A_ur_flange"/>
    <child link="arm_A_ur_tool0"/>
  </joint>
  <!-- 创建 RealSense 相机支架 -->
  <!-- 该支架的相机螺纹孔距离机械臂末端圆心100mm，支架厚度3mm -->
  <link name="arm_A_realsense_shelf">
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.044 0.0015"/>
      <mass value="0.038"/>
      <inertia ixx="0.00006673" ixy="0.0" ixz="0.0" iyy="0.00000850" iyz="0.0" izz="0.00007517"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://my_env_description/meshes/RealSense_D435_Shelf.STL"/>
      </geometry>
      <material name="anodized_aluminum">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://my_env_description/meshes/RealSense_D435_Shelf.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_A_realsense_tool0_to_realsense_shelf" type="fixed">
    <parent link="arm_A_ur_tool0"/>
    <child link="arm_A_realsense_shelf"/>
    <origin rpy="0 0 3.141592653589793" xyz="0.0 0.0 0.0"/>
  </joint>
  <!-- 创建 RealSense 相机支架 child 端的 link 和 joint -->
  <link name="arm_A_realsense_shelf_child_side"/>
  <joint name="arm_A_realsense_shelf_to_child_side" type="fixed">
    <parent link="arm_A_realsense_shelf"/>
    <child link="arm_A_realsense_shelf_child_side"/>
    <!-- 相机支架厚度 3mm + 夹爪底座坐标z轴偏移3mm -->
    <origin rpy="0 0 0" xyz="0.0 0.0 0.006"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="arm_A_realsense_joint" type="fixed">
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0.0875 0.013"/>
    <parent link="arm_A_realsense_shelf"/>
    <child link="arm_A_realsense_bottom_screw_frame"/>
  </joint>
  <link name="arm_A_realsense_bottom_screw_frame"/>
  <joint name="arm_A_realsense_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="arm_A_realsense_bottom_screw_frame"/>
    <child link="arm_A_realsense_link"/>
  </joint>
  <link name="arm_A_realsense_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="file:///opt/ros/humble/share/realsense2_description/meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="arm_A_realsense_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="arm_A_realsense_link"/>
    <child link="arm_A_realsense_depth_frame"/>
  </joint>
  <link name="arm_A_realsense_depth_frame"/>
  <joint name="arm_A_realsense_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_A_realsense_depth_frame"/>
    <child link="arm_A_realsense_depth_optical_frame"/>
  </joint>
  <link name="arm_A_realsense_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="arm_A_realsense_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="arm_A_realsense_link"/>
    <child link="arm_A_realsense_infra1_frame"/>
  </joint>
  <link name="arm_A_realsense_infra1_frame"/>
  <joint name="arm_A_realsense_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_A_realsense_infra1_frame"/>
    <child link="arm_A_realsense_infra1_optical_frame"/>
  </joint>
  <link name="arm_A_realsense_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="arm_A_realsense_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="arm_A_realsense_link"/>
    <child link="arm_A_realsense_infra2_frame"/>
  </joint>
  <link name="arm_A_realsense_infra2_frame"/>
  <joint name="arm_A_realsense_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_A_realsense_infra2_frame"/>
    <child link="arm_A_realsense_infra2_optical_frame"/>
  </joint>
  <link name="arm_A_realsense_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="arm_A_realsense_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="arm_A_realsense_link"/>
    <child link="arm_A_realsense_color_frame"/>
  </joint>
  <link name="arm_A_realsense_color_frame"/>
  <joint name="arm_A_realsense_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_A_realsense_color_frame"/>
    <child link="arm_A_realsense_color_optical_frame"/>
  </joint>
  <link name="arm_A_realsense_color_optical_frame"/>
  <joint name="arm_A_robotiq_ur_to_robotiq_joint" type="fixed">
    <!-- The parent link must be read from the robot model it is attached to. -->
    <parent link="arm_A_realsense_shelf_child_side"/>
    <child link="arm_A_robotiq_ur_to_robotiq_link"/>
    <origin rpy="0 0 0.0" xyz="0 0 0"/>
  </joint>
