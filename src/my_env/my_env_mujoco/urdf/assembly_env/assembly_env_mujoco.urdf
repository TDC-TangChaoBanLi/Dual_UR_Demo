  <!-- base_joint fixes base_link to the environment -->
  <joint name="arm_B_ur_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="ur_mount_B"/>
    <child link="arm_B_ur_base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="arm_B_ur_base_link-base_link_inertia" type="fixed">
    <parent link="arm_B_ur_base_link"/>
    <child link="arm_B_ur_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="arm_B_ur_shoulder_pan_joint" type="revolute">
    <parent link="arm_B_ur_base_link_inertia"/>
    <child link="arm_B_ur_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_B_ur_shoulder_lift_joint" type="revolute">
    <parent link="arm_B_ur_shoulder_link"/>
    <child link="arm_B_ur_upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_B_ur_elbow_joint" type="revolute">
    <parent link="arm_B_ur_upper_arm_link"/>
    <child link="arm_B_ur_forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="arm_B_ur_wrist_1_joint" type="revolute">
