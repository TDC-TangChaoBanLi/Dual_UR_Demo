    <inertial>
      <origin rpy="0 0 0" xyz="0.01456706 5e-05 0.01649701"/>
      <mass value="4.268588744e-02"/>
      <inertia ixx="1.048152e-05" ixy="0.0" ixz="-3.5232e-06" iyy="1.197888e-05" iyz="0.0" izz="4.22784e-06"/>
    </inertial>
  </link>
  <joint name="arm_B_robotiq_85_base_joint" type="fixed">
    <parent link="arm_B_robotiq_ur_to_g2f85_child_side"/>
    <child link="arm_B_robotiq_85_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="arm_B_robotiq_85_left_knuckle_joint" type="revolute">
    <parent link="arm_B_robotiq_85_base_link"/>
    <child link="arm_B_robotiq_85_left_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.03060114 0.0 0.05490452"/>
    <limit effort="50" lower="0.0" upper="0.8" velocity="0.5"/>
  </joint>
  <joint name="arm_B_robotiq_85_right_knuckle_joint" type="revolute">
    <parent link="arm_B_robotiq_85_base_link"/>
    <child link="arm_B_robotiq_85_right_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.03060114 0.0 0.05490452"/>
    <limit effort="50" lower="-0.8" upper="0.0" velocity="0.5"/>
    <mimic joint="arm_B_robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="arm_B_robotiq_85_left_finger_joint" type="fixed">
    <parent link="arm_B_robotiq_85_left_knuckle_link"/>
    <child link="arm_B_robotiq_85_left_finger_link"/>
    <origin rpy="0 0 0" xyz="0.03152616 0.0 -0.00376347"/>
  </joint>
  <joint name="arm_B_robotiq_85_right_finger_joint" type="fixed">
    <parent link="arm_B_robotiq_85_right_knuckle_link"/>
    <child link="arm_B_robotiq_85_right_finger_link"/>
    <origin rpy="0 0 0" xyz="-0.03152616 0.0 -0.00376347"/>
  </joint>
  <joint name="arm_B_robotiq_85_left_inner_knuckle_joint" type="continuous">
    <parent link="arm_B_robotiq_85_base_link"/>
    <child link="arm_B_robotiq_85_left_inner_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.0127 0.0 0.06142"/>
    <mimic joint="arm_B_robotiq_85_left_knuckle_joint"/>
  </joint>
  <joint name="arm_B_robotiq_85_right_inner_knuckle_joint" type="continuous">
    <parent link="arm_B_robotiq_85_base_link"/>
    <child link="arm_B_robotiq_85_right_inner_knuckle_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.0127 0.0 0.06142"/>
    <mimic joint="arm_B_robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="arm_B_robotiq_85_left_finger_tip_joint" type="continuous">
    <parent link="arm_B_robotiq_85_left_finger_link"/>
    <child link="arm_B_robotiq_85_left_finger_tip_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="0.00563134 0.0 0.04718515"/>
    <mimic joint="arm_B_robotiq_85_left_knuckle_joint" multiplier="-1"/>
  </joint>
  <joint name="arm_B_robotiq_85_right_finger_tip_joint" type="continuous">
    <parent link="arm_B_robotiq_85_right_finger_link"/>
    <child link="arm_B_robotiq_85_right_finger_tip_link"/>
    <axis xyz="0 -1 0"/>
    <origin rpy="0 0 0" xyz="-0.00563134 0.0 0.04718515"/>
    <mimic joint="arm_B_robotiq_85_left_knuckle_joint"/>
  </joint>
  <!-- 创建 tcp  -->
  <link name="arm_B__tcp"/>
  <joint name="arm_B__tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.14"/>
    <parent link="arm_B_robotiq_85_base_link"/>
    <child link="arm_B__tcp"/>
  </joint>
  <ros2_control name="my_env_ros2_mujoco" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">/home/tdc/CodeProjects/Dual_UR_Assembly/install/my_env_mujoco/share/my_env_mujoco/urdf/my_env_mujoco.xml</param>
      <param name="pids_config_file">/home/tdc/CodeProjects/Dual_UR_Assembly/install/my_env_control/share/my_env_control/config/mujoco_pids_config.yaml</param>
      <!-- Override the slowdown settings in the Simulate App and run at 3x speed -->
      <param name="sim_speed_factor">1.0</param>
      <!-- If set to true, will not launch the Simulate App window -->
      <param name="headless">false</param>
      <!-- Publish camera images -->
      <param name="camera_publish_rate">30.0</param>
      <!-- Publish lidar scans at 10 hz -->
      <param name="lidar_publish_rate">10.0</param>
    </hardware>
    <!-- 全局相机 -->
    <!-- ! For cameras, the sensor name _must_ match the camera name in the MJCF -->
    <sensor name="global_realsense_camera">
      <!-- Parameters will be used as is -->
      <param name="frame_name">global_realsense_link</param>
      <param name="info_topic">/global_realsense_camera/camera_info</param>
      <param name="image_topic">/global_realsense_camera/color</param>
      <param name="depth_topic">/global_realsense_camera/depth</param>
    </sensor>
    <!-- UR 机械臂相关 -->
    <joint name="arm_A_ur_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.27</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.3</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_A_ur_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <sensor name="arm_A_ur_tcp_fts_sensor">
      <param name="mujoco_type">fts</param>
      <!-- There is _no requirement_ for the mujoco_sensor_name to match the ros2_control sensor name -->
      <param name="mujoco_sensor_name">arm_A_ur_tcp_fts_sensor</param>
      <!-- Default value of force_mjcf_suffix is '_force' -->
      <param name="force_mjcf_suffix">_force</param>
      <!-- Default value of torque_mjcf_suffix is '_torque' -->
      <param name="torque_mjcf_suffix">_torque</param>
      <!-- 上述三个参数配合形成 mjcf 中的力和力矩传感器名称：{mujoco_sensor_name}{force_mjcf_suffix} 和 {mujoco_sensor_name}{torque_mjcf_suffix}  -->
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <!-- ! For cameras, the sensor name _must_ match the camera name in the MJCF -->
    <sensor name="arm_A_realsense_camera">
      <!-- Parameters will be used as is -->
      <param name="frame_name">arm_A_realsense_link</param>
      <param name="info_topic">/arm_A_realsense_camera/camera_info</param>
      <param name="image_topic">/arm_A_realsense_camera/color</param>
      <param name="depth_topic">/arm_A_realsense_camera/depth</param>
    </sensor>
    <!-- Robotiq 2f85 Gripper 相关 -->
    <joint name="arm_A_robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.7929</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- UR 机械臂相关 -->
    <joint name="arm_B_ur_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-2.27</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-0.2</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">-2.24</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_B_ur_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the FakeSystem and simulation -->
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <sensor name="arm_B_ur_tcp_fts_sensor">
      <param name="mujoco_type">fts</param>
      <!-- There is _no requirement_ for the mujoco_sensor_name to match the ros2_control sensor name -->
      <param name="mujoco_sensor_name">arm_B_ur_tcp_fts_sensor</param>
      <!-- Default value of force_mjcf_suffix is '_force' -->
      <param name="force_mjcf_suffix">_force</param>
      <!-- Default value of torque_mjcf_suffix is '_torque' -->
      <param name="torque_mjcf_suffix">_torque</param>
      <!-- 上述三个参数配合形成 mjcf 中的力和力矩传感器名称：{mujoco_sensor_name}{force_mjcf_suffix} 和 {mujoco_sensor_name}{torque_mjcf_suffix}  -->
      <state_interface name="force.x"/>
      <state_interface name="force.y"/>
      <state_interface name="force.z"/>
      <state_interface name="torque.x"/>
      <state_interface name="torque.y"/>
      <state_interface name="torque.z"/>
    </sensor>
    <!-- ! For cameras, the sensor name _must_ match the camera name in the MJCF -->
    <sensor name="arm_B_realsense_camera">
      <!-- Parameters will be used as is -->
      <param name="frame_name">arm_B_realsense_link</param>
      <param name="info_topic">/arm_B_realsense_camera/camera_info</param>
      <param name="image_topic">/arm_B_realsense_camera/color</param>
      <param name="depth_topic">/arm_B_realsense_camera/depth</param>
    </sensor>
    <!-- Robotiq 2f85 Gripper 相关 -->
    <joint name="arm_B_robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.7929</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
